import pandas as pd
data = pd.read_csv("data.csv")

print("Original Data:")
print(data.head())

print("\nMissing Values:")
print(data.isnull().sum())
data.fillna(data.mean(numeric_only=True), inplace=True)

print("\nCleaned Data:")
print(data.head())

print("\nData Description:")
print(data.describe())

